# Persistent event data directory. Use an absolute path on the deployment host.
KAGGRI_DATA_DIR=./data

# Admin endpoints return 503 until a non-empty secret is configured.
KAGGRI_ADMIN_TOKEN=

# Comma-separated exact browser origins; required when the frontend is hosted separately.
KAGGRI_CORS_ORIGINS=

# Set KAGGRI_ENV=production on the event host. Production requires Docker isolation.
KAGGRI_ENV=development
KAGGRI_USE_DOCKER=0

KAGGRI_MAX_WORKERS=2
KAGGRI_EVAL_TIMEOUT=120
KAGGRI_SYSTEM_RETRIES=2

# For a separately hosted frontend, set this at build time to the backend origin.
# VITE_API_BASE_URL=
# For local Vite proxying, this selects the backend target.
# VITE_BACKEND_URL=http://127.0.0.1:8000
